#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Router defaults for the CM5-DUAL-ETH-BOX-B. Runs on first boot and after
# every factory reset.
#   eth1 (2.5GbE) = lan, 192.168.50.1/24, DHCP server
#   eth0 (1GbE)   = wan, DHCP client
#   backup uplinks, tried in this order by mwan3 (/etc/config/mwan3):
#     usb0  = wanusb, Android USB tethering
#     eth2  = wanusbeth, iPhone USB tethering, a USB Ethernet adapter or an LTE stick in HiLink mode
#     wwan0 = wwan, an LTE modem in QMI or MBIM mode (auto-detected; set the APN if the carrier needs one)
# IPv4 only by default: wan6 exists but is not started, no RA/DHCPv6 on lan.
# SSH is off by default: LuCI -> System -> Administration -> SSH Access -> Enable Instance.
#
# OpenWrt runs uci-defaults again after a sysupgrade that keeps settings. The
# marker below comes back with the restored /etc/config/system, so the user's
# own settings are never overwritten; only a fresh flash or factory reset applies these.

[ "$(uci -q get system.@system[0].cm5router_defaults)" = 1 ] && exit 0

uci set system.@system[0].hostname='openwrt-cm5'
uci commit system

# --- SSH off until the user enables it in LuCI ---
uci set dropbear.@dropbear[0].enable='0'
uci commit dropbear

# --- lan on the 2.5GbE port ---
br="$(uci show network | sed -n "s/^network\.\(@device\[[0-9]*\]\)\.name='br-lan'$/\1/p" | head -n1)"
if [ -z "$br" ]; then
	br="$(uci add network device)"
	uci set network.$br.name='br-lan'
	uci set network.$br.type='bridge'
fi
uci -q delete network.$br.ports
uci add_list network.$br.ports='eth1'
uci set network.lan=interface
uci set network.lan.device='br-lan'
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.50.1'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.lan.ip6assign

# --- wan on the 1GbE port, USB uplinks as backups ---
uci set network.wan=interface
uci set network.wan.device='eth0'
uci set network.wan.proto='dhcp'
uci set network.wan.metric='10'

uci set network.wan6=interface
uci set network.wan6.device='eth0'
uci set network.wan6.proto='dhcpv6'
uci set network.wan6.auto='0'

uci set network.wanusb=interface
uci set network.wanusb.device='usb0'
uci set network.wanusb.proto='dhcp'
uci set network.wanusb.metric='20'

uci set network.wanusbeth=interface
uci set network.wanusbeth.device='eth2'
uci set network.wanusbeth.proto='dhcp'
uci set network.wanusbeth.metric='30'

uci set network.wwan=interface
uci set network.wwan.proto='wwan'
uci set network.wwan.metric='40'
uci commit network

# --- DHCP: IPv4 server on lan only ---
uci set dhcp.lan=dhcp
uci set dhcp.lan.interface='lan'
uci set dhcp.lan.ignore='0'
uci set dhcp.lan.dhcpv4='server'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
for iface in wan wanusb wanusbeth wwan; do
	uci set dhcp.$iface=dhcp
	uci set dhcp.$iface.interface="$iface"
	uci set dhcp.$iface.ignore='1'
done
uci commit dhcp

# --- firewall: the backup uplinks are part of the wan zone (NAT, inbound blocked) ---
zone="$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='wan'$/\1/p" | head -n1)"
if [ -n "$zone" ]; then
	for iface in wanusb wanusbeth wwan; do
		uci -q del_list firewall.$zone.network="$iface"
		uci add_list firewall.$zone.network="$iface"
	done
	uci commit firewall
fi

# --- SQM (cake) on wan, off until the line speeds are set: LuCI -> Network -> SQM QoS ---
if [ -f /etc/config/sqm ]; then
	q="$(uci show sqm | sed -n "s/^sqm\.\([^.=]*\)=queue$/\1/p" | head -n1)"
	if [ -z "$q" ]; then
		q="$(uci add sqm queue)"
	fi
	[ "$q" = wan ] || uci rename sqm.$q='wan'
	uci set sqm.wan.enabled='0'
	uci set sqm.wan.interface='eth0'
	uci set sqm.wan.qdisc='cake'
	uci set sqm.wan.script='piece_of_cake.qos'
	uci set sqm.wan.download='0'
	uci set sqm.wan.upload='0'
	uci commit sqm
fi

# --- traffic stats: keep the nlbwmon database on flash instead of RAM ---
if [ -f /etc/config/nlbwmon ]; then
	mkdir -p /etc/nlbwmon
	uci set nlbwmon.@nlbwmon[0].database_directory='/etc/nlbwmon'
	uci commit nlbwmon
fi

# --- status LED: ACT shows the wan link and blinks with wan traffic ---
uci set system.led_wan=led
uci set system.led_wan.name='WAN'
uci set system.led_wan.sysfs='ACT'
uci set system.led_wan.trigger='netdev'
uci set system.led_wan.dev='eth0'
uci set system.led_wan.mode='link tx rx'

# --- DNS: Cloudflare next to whatever the uplink hands out, so names still
# resolve when the active backup uplink cannot reach the wan's DNS servers ---
uci -q del_list dhcp.@dnsmasq[0].server='1.1.1.1'
uci -q del_list dhcp.@dnsmasq[0].server='1.0.0.1'
uci add_list dhcp.@dnsmasq[0].server='1.1.1.1'
uci add_list dhcp.@dnsmasq[0].server='1.0.0.1'
uci commit dhcp

# --- UPnP/NAT-PMP installed but off: LuCI -> Services -> UPnP IGD & PCP ---
if [ -f /etc/config/upnpd ]; then
	uci set upnpd.config.enabled='0'
	uci commit upnpd
fi

uci set system.@system[0].cm5router_defaults='1'
uci commit system

exit 0
