
config globals 'globals'
	option mmx_mask '0x3F00'

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	list track_ip '9.9.9.9'
	option reliability '2'
	option interval '5'
	option down '3'
	option up '3'
	list flush_conntrack 'connected'
	list flush_conntrack 'disconnected'

config interface 'wanusb'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	list track_ip '9.9.9.9'
	option reliability '2'
	option interval '5'
	option down '3'
	option up '3'

config interface 'wanusbeth'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	list track_ip '9.9.9.9'
	option reliability '2'
	option interval '5'
	option down '3'
	option up '3'

config interface 'wwan'
	option enabled '1'
	option family 'ipv4'
	list track_ip '1.1.1.1'
	list track_ip '8.8.8.8'
	list track_ip '9.9.9.9'
	option reliability '2'
	option interval '5'
	option down '3'
	option up '3'

config member 'wan_m1'
	option interface 'wan'
	option metric '1'

config member 'wanusb_m2'
	option interface 'wanusb'
	option metric '2'

config member 'wanusbeth_m3'
	option interface 'wanusbeth'
	option metric '3'

config member 'wwan_m4'
	option interface 'wwan'
	option metric '4'

config policy 'failover'
	list use_member 'wan_m1'
	list use_member 'wanusb_m2'
	list use_member 'wanusbeth_m3'
	list use_member 'wwan_m4'
	option last_resort 'unreachable'

config rule 'default_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'failover'
