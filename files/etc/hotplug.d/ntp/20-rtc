#
# Save the system time to the RTC whenever NTP reports a valid time, so a
# battery-backed RTC is still right after a power cut. OpenWrt's sysfixtime only
# writes it at a clean shutdown. Harmless without a battery.

[ "$ACTION" = stratum ] || exit 0
[ -e /dev/rtc0 ] || exit 0

hwclock -w -u -f /dev/rtc0
